PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Chat image directory for npm start (absolute or relative to the project).
# Images expire 14 days after the last play session ends. Back up DATA_DIR/images.json too.
IMAGE_DIR=./data/images
# Docker only: optional absolute host directory mounted at /app/images.
# Leave blank to use the persistent image-data volume.
IMAGE_STORAGE_PATH=
# Optional: enable the host-only inspiration window.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# For a deployed site, set its exact origin, e.g. https://trpg.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
